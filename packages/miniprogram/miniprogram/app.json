{
  "pages": [
    "pages/card/card",
    "pages/requests/requests",
    "pages/vibe/vibe",
    "pages/visitor-chat/visitor-chat"
  ],
  "subPackages": [
    {
      "root": "pages/legacy",
      "name": "legacy",
      "pages": [
        "threads/threads",
        "more/more",
        "discover/discover",
        "games/games",
        "thread-publish/thread-publish"
      ]
    }
  ],
  "preloadRule": {
    "pages/card/card": {
      "network": "all",
      "packages": ["legacy"]
    }
  },
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "VibeCard",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#ffffff",
    "navigationStyle": "custom"
  },
  "tabBar": {
    "custom": true,
    "color": "#737373",
    "selectedColor": "#0a0a0a",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "position": "bottom",
    "list": [
      {
        "pagePath": "pages/card/card",
        "text": "名片",
        "iconPath": "images/tab_home.png",
        "selectedIconPath": "images/tab_home_active.png"
      },
      {
        "pagePath": "pages/requests/requests",
        "text": "请求",
        "iconPath": "images/tab_threads.png",
        "selectedIconPath": "images/tab_threads_active.png"
      },
      {
        "pagePath": "pages/vibe/vibe",
        "text": "Vibe",
        "iconPath": "images/tab_settings.png",
        "selectedIconPath": "images/tab_settings_active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "__usePrivacyCheck__": true
}
