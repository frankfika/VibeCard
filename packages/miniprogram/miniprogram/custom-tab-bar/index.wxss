.tab-bar-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  pointer-events: none;
}

.tab-bar-fade {
  height: 24rpx;
  background: linear-gradient(to top, rgba(255,255,255,0.8), transparent);
  pointer-events: none;
}

.tab-bar {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 -8rpx 60rpx rgba(0, 0, 0, 0.04);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  padding-top: 16rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  pointer-events: auto;
}

.tab-bar-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  max-width: 750rpx;
  margin: 0 auto;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  position: relative;
  transition: all 0.3s ease-out;
}

.tab-item-bg {
  position: absolute;
  inset: 0;
  border-radius: 32rpx;
  background: rgba(10, 10, 10, 0.08);
  transform: scale(1);
  opacity: 1;
}

.tab-icon {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  line-height: 1;
  transition: all 0.3s ease-out;
}

.tab-item-active .tab-icon {
  transform: scale(1.1) translateY(-2rpx);
}

.tab-label {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
  transition: all 0.3s ease-out;
}

.tab-item:not(.tab-item-active) .tab-label {
  color: #737373;
  opacity: 0.7;
}

.tab-item-active .tab-label {
  color: #0a0a0a;
  opacity: 1;
}
