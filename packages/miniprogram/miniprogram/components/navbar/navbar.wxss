.navbar-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 8rpx 60rpx rgba(0, 0, 0, 0.04);
}

.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-side {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -16rpx;
  border-radius: 50%;
}

.navbar-back:active {
  background: rgba(10, 10, 10, 0.05);
}

.navbar-back-icon {
  font-size: 48rpx;
  font-weight: 400;
  color: #0a0a0a;
  line-height: 1;
  margin-top: -4rpx;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: #0a0a0a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 深色模式（访客分身对话等深色页面） */
.navbar-dark {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.navbar-dark .navbar-title {
  color: #f5f2ec;
}

.navbar-dark .navbar-back-icon {
  color: #f5f2ec;
}

.navbar-dark .navbar-back:active {
  background: rgba(255, 255, 255, 0.08);
}
