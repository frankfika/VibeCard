<view class="page">
  <navbar title="我的名片" />

  <!-- Onboarding -->
  <view wx:if="{{showOnboarding}}" class="onboarding">
    <view class="onboarding-content">
      <view class="first-run-brand">VIBECARD · 私人 Vibe</view>

      <view wx:if="{{firstRunStage === 'intro'}}" class="first-run-scene">
        <view class="first-run-vibe-bubble">
          我是你的私人 Vibe。我们聊五个小问题，我会先把值得记住的事交给你确认，再一起发布第一张 Card。
        </view>
        <view class="first-run-privacy">对话默认不公开；没有你的确认，记忆不会生效，Card 也不会发布。</view>
        <input class="first-run-input" placeholder="我该怎么称呼你？" placeholder-style="color: #9b9ba4;" value="{{firstRunName}}" bindinput="onFirstRunNameInput" maxlength="40" />
        <button class="btn-primary first-run-primary" bindtap="onStartFirstRun">开始聊聊</button>
      </view>

      <view wx:if="{{firstRunStage === 'questions'}}" class="first-run-scene">
        <view class="first-run-progress">问题 {{firstRunQuestionNumber}} / 5</view>
        <view class="first-run-history">
          <view wx:for="{{firstRunHistory}}" wx:key="id" class="first-run-exchange">
            <view class="first-run-history-q">{{item.prompt}}</view>
            <view class="first-run-history-a {{item.skipped ? 'first-run-muted' : ''}}">{{item.answer}}</view>
          </view>
        </view>
        <view class="first-run-vibe-bubble">{{firstRunQuestion.prompt}}</view>
        <textarea class="first-run-textarea" placeholder="{{firstRunQuestion.placeholder}}" placeholder-style="color: #9b9ba4;" value="{{firstRunAnswer}}" bindinput="onFirstRunAnswerInput" auto-height maxlength="240" />
        <button class="btn-primary first-run-primary" bindtap="onAnswerFirstRunQuestion">告诉 Vibe</button>
        <view class="first-run-row">
          <view wx:if="{{firstRunQuestionNumber > 1}}" class="first-run-link" bindtap="onBackFirstRunQuestion">← 返回纠正</view>
          <view class="first-run-link first-run-link-right" bindtap="onSkipFirstRunQuestion">先跳过</view>
        </view>
        <view wx:if="{{firstRunQuestion.id === 'boundary'}}" class="first-run-private-note">这条即使被记住，也会强制保持「仅自己可见」。</view>
      </view>

      <view wx:if="{{firstRunStage === 'memory-review'}}" class="first-run-scene">
        <view class="first-run-progress">由你决定要不要记住</view>
        <view class="first-run-vibe-bubble">这件事以后可能有用。我先提议，不会自动记住。</view>
        <view class="first-run-memory-card">
          <view class="first-run-memory-head">
            <text>可能值得记住</text>
            <text class="first-run-memory-visibility">{{firstRunProposal.visibilityLabel}}</text>
          </view>
          <view wx:if="{{!firstRunProposalEditing}}" class="first-run-memory-content">{{firstRunProposal.content}}</view>
          <textarea wx:else class="first-run-textarea" value="{{firstRunProposalText}}" bindinput="onFirstRunProposalInput" auto-height maxlength="240" />
        </view>
        <view wx:if="{{firstRunBusy}}" class="first-run-status">正在安全保存…</view>
        <view wx:if="{{firstRunError}}" class="first-run-error">
          <view>{{firstRunError}}</view>
          <view class="first-run-retry" bindtap="onConfirmFirstRunMemory">{{firstRunPermissionDenied ? '登录后重试' : '重新保存'}}</view>
        </view>
        <view wx:if="{{!firstRunBusy}}" class="first-run-actions">
          <button class="btn-primary first-run-action-main" bindtap="onConfirmFirstRunMemory">{{firstRunProposalEditing ? '确认记住修改' : '记住'}}</button>
          <view wx:if="{{!firstRunProposalEditing}}" class="first-run-action" bindtap="onEditFirstRunProposal">改一下</view>
          <view wx:else class="first-run-action" bindtap="onCancelFirstRunProposalEdit">取消修改</view>
          <view class="first-run-action first-run-action-quiet" bindtap="onDismissFirstRunMemory">别记这个</view>
        </view>
      </view>

      <view wx:if="{{firstRunStage === 'draft-loading'}}" class="first-run-scene first-run-center">
        <view class="first-run-orb">✦</view>
        <view class="first-run-loading-title">Vibe 正在起草你的 Card…</view>
        <view class="first-run-privacy">只使用你刚才明确确认过的记忆；跳过或拒绝的内容不会进入草稿。</view>
      </view>

      <view wx:if="{{firstRunStage === 'draft-error'}}" class="first-run-scene">
        <view class="first-run-vibe-bubble">{{firstRunError}}</view>
        <button class="btn-primary first-run-primary" bindtap="onRetryFirstRunDraft">{{firstRunPermissionDenied ? '登录后重试' : '重新起草'}}</button>
        <view class="first-run-link first-run-link-right" bindtap="onUseConfirmedAnswersDraft">先用已确认的原话起草</view>
      </view>

      <view wx:if="{{firstRunStage === 'draft'}}" class="first-run-scene">
        <view class="first-run-progress">发布前的最后确认</view>
        <view class="first-run-vibe-bubble">我试着把此刻的你写成了一张 Card。空白项会保持空白，不会替你猜。</view>
        <view class="first-run-draft">
          <view class="first-run-draft-field">
            <view class="first-run-draft-label">名字</view>
            <input class="first-run-draft-input" value="{{firstRunDraft.name}}" bindinput="onFirstRunDraftInput" data-key="name" maxlength="40" />
          </view>
          <view wx:if="{{firstRunDraft.bio !== undefined}}" class="first-run-draft-field">
            <view class="first-run-draft-label">此刻的我</view>
            <textarea class="first-run-draft-input" value="{{firstRunDraft.bio}}" bindinput="onFirstRunDraftInput" data-key="bio" auto-height maxlength="240" />
          </view>
          <view wx:if="{{firstRunDraft.highlights && firstRunDraft.highlights.length}}" class="first-run-draft-field">
            <view class="first-run-draft-label">代表作品 / 经历</view>
            <textarea class="first-run-draft-input" value="{{firstRunDraft.highlights[0].title}}" bindinput="onFirstRunDraftInput" data-key="work" auto-height maxlength="240" />
          </view>
          <view wx:if="{{firstRunDraft.canHelpWith && firstRunDraft.canHelpWith.length}}" class="first-run-draft-field">
            <view class="first-run-draft-label">我能帮什么</view>
            <textarea class="first-run-draft-input" value="{{firstRunDraft.canHelpWith[0]}}" bindinput="onFirstRunDraftInput" data-key="help" auto-height maxlength="240" />
          </view>
          <view wx:if="{{firstRunDraft.lookingFor !== undefined}}" class="first-run-draft-field">
            <view class="first-run-draft-label">我想遇见谁</view>
            <textarea class="first-run-draft-input" value="{{firstRunDraft.lookingFor}}" bindinput="onFirstRunDraftInput" data-key="lookingFor" auto-height maxlength="240" />
          </view>
          <view wx:if="{{!firstRunDraft.bio && (!firstRunDraft.highlights || !firstRunDraft.highlights.length) && (!firstRunDraft.canHelpWith || !firstRunDraft.canHelpWith.length) && !firstRunDraft.lookingFor}}" class="first-run-empty">你跳过了全部内容，这张 Card 只会发布名字。之后可以用结构化编辑器慢慢补充。</view>
        </view>
        <view class="first-run-private-note">隐私边界不会出现在公开 Card 中。发布后仍可使用「编辑名片」精细调整。</view>
        <view wx:if="{{firstRunError}}" class="first-run-error">{{firstRunError}}</view>
        <button class="btn-primary first-run-primary" bindtap="onPublishFirstRunCard" loading="{{firstRunBusy}}">确认并发布 Card</button>
      </view>
    </view>
  </view>

  <!-- Main Card View -->
  <view wx:if="{{isSetup && !showOnboarding}}" class="card-container">
    <scroll-view scroll-y class="card-scroll">
      <view class="card-inner {{cardVisible ? 'card-enter' : 'card-hidden'}}">
        <!-- Profile Header -->
        <view class="profile-header">
          <view class="avatar-wrap">
            <image wx:if="{{profile.avatar && !avatarFailed}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" binderror="onAvatarError" />
            <view wx:else class="avatar avatar-placeholder">{{profile.name ? profile.name[0] : '?'}}</view>
          </view>
          <view class="profile-name">{{profile.name}}</view>
          <view wx:if="{{profile.handle}}" class="profile-handle">{{profile.handle}}</view>
        </view>

        <!-- Tags & Event -->
        <view wx:if="{{profile.event || (profile.tags && profile.tags.length > 0)}}" class="tags-wrap" bindtap="{{isSharedView ? 'noop' : 'openEdit'}}">
          <view wx:if="{{profile.event}}" class="profile-tag profile-tag-event">📍 {{profile.event}}</view>
          <view wx:for="{{profile.tags}}" wx:key="label" class="profile-tag">{{item.label}}</view>
          <view wx:if="{{!isSharedView}}" class="profile-tag profile-tag-add">+ 编辑</view>
        </view>

        <!-- Bio -->
        <view wx:if="{{profile.bio}}" class="bio-card">
          <view class="bio-quote">"</view>
          <text class="bio-text">{{profile.bio}}</text>
          <view class="bio-quote bio-quote-close">"</view>
        </view>

        <!-- Looking For -->
        <view wx:if="{{profile.lookingFor}}" class="looking-card">
          <view class="looking-icon">↗</view>
          <view class="looking-content">
            <view class="looking-label">LOOKING FOR</view>
            <view class="looking-value">{{profile.lookingFor}}</view>
          </view>
        </view>

        <view wx:if="{{profile.canHelpWith && profile.canHelpWith.length}}" class="looking-card can-help-card">
          <view class="looking-icon">+</view>
          <view class="looking-content">
            <view class="looking-label">我能帮什么</view>
            <view wx:for="{{profile.canHelpWith}}" wx:key="*this" class="looking-value">{{item}}</view>
          </view>
        </view>

        <!-- Verified -->
        <!-- 联系方式（含已验证账号）只在连接成功后可见；访客/分享视图一律隐藏，不对外暴露 -->
        <view wx:if="{{!isSharedView && profile.verified && (profile.verified.wallet || profile.verified.twitter || profile.verified.discord || profile.verified.wechat)}}" class="verified-card">
          <view wx:if="{{profile.verified.wallet}}" class="verified-chip">Wallet</view>
          <view wx:if="{{profile.verified.twitter}}" class="verified-chip">X</view>
          <view wx:if="{{profile.verified.discord}}" class="verified-chip">Discord</view>
          <view wx:if="{{profile.verified.wechat}}" class="verified-chip">WeChat</view>
        </view>

        <!-- 最近动态（任务 4.5）：最多 3 条主人发布且未过期的动态；没有就不渲染，绝不编造 -->
        <view wx:if="{{nowItems && nowItems.length > 0}}" class="now-section">
          <view class="section-label">最近动态</view>
          <view wx:for="{{nowItems}}" wx:key="id" class="now-item">
            <view class="now-item-topic">{{item.topicLabel}}</view>
            <view class="now-item-text">{{item.text}}</view>
          </view>
        </view>

        <!-- Highlights -->
        <view wx:if="{{profile.highlights && profile.highlights.length > 0}}" class="highlights-wrap">
          <view class="section-label">HIGHLIGHTS</view>
          <view wx:for="{{profile.highlights}}" wx:key="id" class="highlight-item">
            <view class="highlight-icon">{{item.icon}}</view>
            <view class="highlight-title">{{item.title}}</view>
          </view>
        </view>

        <!-- Moment Preview -->
        <view wx:if="{{profile.latestMoment}}" class="moment-preview">
          <view class="moment-header">
            <view class="moment-title">最新动态</view>
          </view>
          <view class="moment-content">{{profile.latestMoment}}</view>
        </view>
      </view>
      <view class="bottom-space {{isSharedView ? 'bottom-space-lg' : ''}}" />
    </scroll-view>

    <!-- Actions -->
    <view class="action-bar {{isSharedView ? 'action-bar-column' : ''}}" wx:if="{{!isEditing}}">
      <button wx:if="{{!isSharedView}}" class="btn-secondary" bindtap="openEdit">编辑名片</button>
      <button wx:if="{{!isSharedView}}" class="btn-primary" open-type="share">分享我的名片</button>
      <!-- 访客视图：先和主人的 AI 分身聊聊，再带着具体理由请求认识 -->
      <button wx:if="{{isSharedView}}" class="btn-primary btn-agent-entry" bindtap="goVisitorChat">先和我的分身聊聊</button>
      <button wx:if="{{isSharedView}}" class="btn-secondary" bindtap="goHome">创建我自己的 VibeCard</button>
    </view>
  </view>

  <!-- Share Canvas -->
  <canvas type="2d" id="shareCanvas" style="width: 750px; height: 600px; position: fixed; top: -9999px; left: -9999px;"></canvas>

  <!-- Edit Modal -->
  <wxs module="utils">
    module.exports = {
      includes: function(arr, item) {
        if (!arr) return false;
        return arr.indexOf(item) !== -1;
      }
    }
  </wxs>

  <view wx:if="{{isEditing}}" class="modal-overlay" bindtap="closeEdit">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title">编辑名片</view>
        <view class="modal-actions">
          <view class="modal-close" bindtap="closeEdit">取消</view>
          <view class="modal-save-btn" bindtap="saveEdit">完成</view>
        </view>
      </view>
      <scroll-view scroll-y class="modal-body" enhanced show-scrollbar="{{false}}" scroll-into-view="">
        <!-- Avatar -->
        <view class="edit-section">
          <view class="section-title-new">头像</view>
          <view class="avatar-edit-row">
            <view class="avatar-preview-wrap" bindtap="chooseAvatar">
              <image wx:if="{{editAvatar}}" class="avatar-preview-img" src="{{editAvatar}}" mode="aspectFill" />
              <view wx:else class="avatar-preview-placeholder">{{editName ? editName[0] : '?'}}</view>
            </view>
            <view class="avatar-edit-actions">
              <view class="avatar-mode-pill {{avatarMode === 'generated' ? 'avatar-mode-active' : ''}}" bindtap="setAvatarMode" data-mode="generated">随机生成</view>
              <view class="avatar-mode-pill {{avatarMode === 'custom' ? 'avatar-mode-active' : ''}}" bindtap="setAvatarMode" data-mode="custom">本地上传</view>
            </view>
          </view>
          <view wx:if="{{avatarMode === 'generated'}}" class="avatar-grid">
            <view wx:for="{{avatarOptions}}" wx:key="key" class="avatar-option {{editAvatar === item.url ? 'avatar-option-active' : ''}}" bindtap="selectAvatarSeed" data-url="{{item.url}}" data-seed="{{item.key}}">
              <image class="avatar-option-img" src="{{item.url}}" mode="aspectFit" lazy-load />
            </view>
          </view>
          <view wx:if="{{avatarMode === 'custom'}}" class="field-tip">点击头像从相册或相机选择</view>
        </view>

        <!-- Basic Info -->
        <view class="edit-section">
          <view class="input-group">
            <view class="input-label">名字 <text class="input-required">*</text></view>
            <input class="edit-input font-bold" placeholder="你的名字" placeholder-style="color: #a3a3a3;" value="{{editName}}" bindinput="onEditNameInput" />
          </view>
          <view class="input-group">
            <view class="input-label">vibecard ID</view>
            <input class="edit-input edit-input-handle" placeholder="vibecard ID" placeholder-style="color: #a3a3a3;" value="{{editHandle}}" bindinput="onEditHandleInput" />
          </view>
          <view class="input-group">
            <view class="input-label">个人简介</view>
            <textarea class="edit-textarea" placeholder="写一句炫酷的个人简介..." placeholder-style="color: #a3a3a3;" value="{{editBio}}" bindinput="onEditBioInput" />
            <view class="field-tip">简介会展示在名片正文中</view>
          </view>
        </view>

        <!-- Tags -->
        <view class="edit-section">
          <view class="section-header">
            <text class="section-title-new">我的标签</text>
            <text class="section-subtitle-new">{{editTags.length}}/5</text>
          </view>
          <view class="pill-grid">
            <view wx:for="{{tagOptions}}" wx:key="*this" class="pill {{utils.includes(editTags, item) ? 'pill-active' : ''}}" bindtap="onEditTagSelect" data-tag="{{item}}">{{item}}</view>
          </view>
          <view class="custom-tag-row">
            <input class="custom-tag-input" placeholder="输入自定义标签..." placeholder-style="color: #a3a3a3;" value="{{editCustomTag}}" bindinput="onEditCustomTagInput" />
            <view class="custom-tag-btn {{editCustomTag ? 'custom-tag-btn-active' : ''}}" bindtap="addEditCustomTag">添加</view>
          </view>
        </view>

        <!-- Looking For -->
        <view class="edit-section">
          <view class="section-title-new">寻找什么</view>
          <view class="pill-grid">
            <view wx:for="{{lookingForOptions}}" wx:key="*this" class="pill-card {{editLookingFor === item ? 'pill-card-active' : ''}}" bindtap="onEditLookingSelect" data-item="{{item}}">{{item}}</view>
          </view>
        </view>

        <view class="edit-section">
          <view class="section-title-new">我能帮什么</view>
          <view class="field-tip">一行一项；这是公开 Card 内容</view>
          <textarea class="textarea textarea-focusable" value="{{editCanHelpWith}}" placeholder="例如：把复杂产品梳理成清晰流程" bindinput="onEditCanHelpInput" maxlength="360" />
        </view>

        <!-- Event -->
        <view class="edit-section">
          <view class="section-title-new">当前活动</view>
          <view class="pill-grid">
            <view wx:for="{{eventOptions}}" wx:key="*this" class="pill-card {{editEvent === item ? 'pill-card-active' : ''}}" bindtap="onEditEventSelect" data-item="{{item}}">{{item}}</view>
          </view>
        </view>

        <!-- Verified Accounts -->
        <view class="edit-section">
          <view class="section-title-new">已验证账号（选填）</view>
          <view class="field-tip">添加你的社交账号，展示在名片上</view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">W</view>
            <input class="verified-input" placeholder="钱包地址 0x..." value="{{editWallet}}" bindinput="onEditWalletInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">X</view>
            <input class="verified-input" placeholder="Twitter @handle" value="{{editTwitter}}" bindinput="onEditTwitterInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">D</view>
            <input class="verified-input" placeholder="Discord username" value="{{editDiscord}}" bindinput="onEditDiscordInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">微</view>
            <input class="verified-input" placeholder="微信 ID" value="{{editWechat}}" bindinput="onEditWechatInput" />
          </view>
        </view>

        <!-- Highlights -->
        <view class="edit-section">
          <view class="section-header">
            <text class="section-title-new">高光时刻</text>
            <text class="section-subtitle-new" bindtap="addHighlight">+ 添加</text>
          </view>
          <view wx:for="{{editHighlights}}" wx:key="id" class="highlight-edit-row">
            <input class="highlight-edit-icon" value="{{item.icon}}" placeholder="·" maxlength="2" bindinput="onHighlightIconInput" data-id="{{item.id}}" />
            <input class="highlight-edit-title" value="{{item.title}}" placeholder="一句话描述..." bindinput="onHighlightTitleInput" data-id="{{item.id}}" />
            <view class="highlight-edit-delete" bindtap="removeHighlight" data-id="{{item.id}}">✕</view>
          </view>
          <view wx:if="{{editHighlights.length === 0}}" class="field-tip">点击"+ 添加"记录你的高光时刻</view>
        </view>

        <view class="bottom-space-sm" />
      </scroll-view>
    </view>
  </view>
</view>
