<view class="page">
  <navbar title="我的名片" />

  <!-- Onboarding -->
  <view wx:if="{{showOnboarding}}" class="onboarding">
    <view class="onboarding-content">
      <!-- Step Indicator -->
      <view class="step-indicator">
        <view wx:for="{{[0,1,2]}}" wx:key="*this" class="step-dot {{onboardingStep === item ? 'step-dot-active' : ''}} {{onboardingStep > item ? 'step-dot-completed' : ''}}"></view>
      </view>
      <view class="step-line">
        <view class="step-line-progress" style="width: {{(onboardingStep / 2) * 100}}%"></view>
      </view>

      <view class="onboarding-step-wrap">
        <view class="onboarding-step-title">{{onboardingSteps[onboardingStep].title}}</view>
        <view class="onboarding-step-subtitle">{{onboardingSteps[onboardingStep].subtitle}}</view>
        <view class="onboarding-step-hint">{{onboardingSteps[onboardingStep].hint}}</view>
      </view>

      <view wx:if="{{onboardingStep === 0}}" class="onboarding-step-body">
        <view class="input-group">
          <view class="input-label">你的名字 <text class="input-required">*</text></view>
          <input class="input input-focusable" placeholder="例如：Alex Chen" placeholder-style="color: #a3a3a3;" value="{{onboardingName}}" bindinput="onOnboardingNameInput" />
        </view>
        <view class="input-group">
          <view class="input-label">vibecard ID</view>
          <input class="input input-focusable" placeholder="你的专属标识" placeholder-style="color: #a3a3a3;" value="{{onboardingHandle}}" bindinput="onOnboardingHandleInput" />
          <view class="input-tip">ID 会显示在你的名片链接中</view>
        </view>
      </view>

      <view wx:if="{{onboardingStep === 1}}" class="onboarding-step-body">
        <view class="input-group">
          <view class="input-label">选择标签 <text class="input-count">{{onboardingTags.length}}/5</text></view>
          <view class="tag-grid">
            <view wx:for="{{tagOptions}}" wx:key="*this" class="tag-item {{onboardingTags.includes(item) ? 'tag-active' : ''}}" bindtap="onOnboardingTagSelect" data-tag="{{item}}">{{item}}</view>
          </view>
        </view>
        <view class="custom-tag-row">
          <input class="custom-tag-input" placeholder="自定义标签..." placeholder-style="color: #a3a3a3;" value="{{onboardingCustomTag}}" bindinput="onOnboardingCustomTagInput" />
          <view class="custom-tag-btn {{onboardingCustomTag ? 'custom-tag-btn-active' : ''}}" bindtap="addOnboardingCustomTag">添加</view>
        </view>
      </view>

      <view wx:if="{{onboardingStep === 2}}" class="onboarding-step-body">
        <view class="input-group">
          <view class="input-label">个人简介</view>
          <textarea class="textarea textarea-focusable" placeholder="一句话介绍自己..." placeholder-style="color: #a3a3a3;" value="{{onboardingBio}}" bindinput="onOnboardingBioInput" />
        </view>
        <view class="input-group">
          <view class="input-label">Looking for</view>
          <view class="option-list">
            <view wx:for="{{lookingForOptions}}" wx:key="*this" class="option-item {{onboardingLookingFor === item ? 'option-active' : ''}}" bindtap="onOnboardingLookingSelect" data-item="{{item}}">{{item}}</view>
          </view>
        </view>
        <view class="input-group">
          <view class="input-label">当前活动</view>
          <view class="option-list">
            <view wx:for="{{eventOptions}}" wx:key="*this" class="option-item {{onboardingEvent === item ? 'option-active' : ''}}" bindtap="onOnboardingEventSelect" data-item="{{item}}">{{item}}</view>
          </view>
        </view>
      </view>

      <view class="onboarding-actions">
        <button class="btn-primary" bindtap="nextOnboardingStep">{{onboardingStep >= 2 ? '完成' : '下一步'}}</button>
        <view class="onboarding-secondary">
          <view wx:if="{{onboardingStep > 0}}" class="btn-text" bindtap="prevOnboardingStep">← 上一步</view>
          <view class="btn-text btn-skip" bindtap="skipOnboarding">跳过，稍后完善</view>
        </view>
      </view>
    </view>
  </view>

  <!-- Main Card View -->
  <view wx:if="{{isSetup && !showOnboarding}}" class="card-container">
    <scroll-view scroll-y class="card-scroll">
      <view class="card-inner {{cardVisible ? 'card-enter' : 'card-hidden'}}">
        <!-- Profile Header -->
        <view class="profile-header">
          <view class="avatar-wrap">
            <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" />
            <view wx:else class="avatar avatar-placeholder">{{profile.name ? profile.name[0] : '?'}}</view>
          </view>
          <view class="profile-name">{{profile.name}}</view>
          <view wx:if="{{profile.handle}}" class="profile-handle">{{profile.handle}}</view>
        </view>

        <!-- Tags & Event -->
        <view wx:if="{{profile.event || (profile.tags && profile.tags.length > 0)}}" class="tags-wrap" bindtap="openEdit">
          <view wx:if="{{profile.event}}" class="profile-tag profile-tag-event">📍 {{profile.event}}</view>
          <view wx:for="{{profile.tags}}" wx:key="label" class="profile-tag">{{item.label}}</view>
          <view class="profile-tag profile-tag-add">+ 编辑</view>
        </view>

        <!-- Bio -->
        <view wx:if="{{profile.bio}}" class="bio-card">
          <view class="bio-quote">"</view>
          <text class="bio-text">{{profile.bio}}</text>
          <view class="bio-quote bio-quote-close">"</view>
        </view>

        <!-- Looking For -->
        <view wx:if="{{profile.lookingFor}}" class="looking-card">
          <view class="looking-icon">⚡</view>
          <view class="looking-content">
            <view class="looking-label">LOOKING FOR</view>
            <view class="looking-value">{{profile.lookingFor}}</view>
          </view>
        </view>

        <!-- Verified -->
        <!-- 联系方式（含已验证账号）只在连接成功后可见；访客/分享视图一律隐藏，不对外暴露 -->
        <view wx:if="{{!isSharedView && profile.verified && (profile.verified.wallet || profile.verified.twitter || profile.verified.discord || profile.verified.wechat)}}" class="verified-card">
          <view wx:if="{{profile.verified.wallet}}" class="verified-item">
            <view class="verified-icon">👛</view>
            <view class="verified-label">Wallet</view>
          </view>
          <view wx:if="{{profile.verified.twitter}}" class="verified-item">
            <view class="verified-icon">𝕏</view>
            <view class="verified-label">X</view>
          </view>
          <view wx:if="{{profile.verified.discord}}" class="verified-item">
            <view class="verified-icon">💬</view>
            <view class="verified-label">Discord</view>
          </view>
          <view wx:if="{{profile.verified.wechat}}" class="verified-item">
            <view class="verified-icon">💚</view>
            <view class="verified-label">WeChat</view>
          </view>
        </view>

        <!-- Highlights -->
        <view wx:if="{{profile.highlights && profile.highlights.length > 0}}" class="highlights-wrap">
          <view class="section-label">HIGHLIGHTS</view>
          <view wx:for="{{profile.highlights}}" wx:key="id" class="highlight-item">
            <view class="highlight-icon">{{item.icon}}</view>
            <view class="highlight-title">{{item.title}}</view>
          </view>
        </view>

        <!-- Moment Preview -->
        <view wx:if="{{profile.latestMoment}}" class="moment-preview">
          <view class="moment-header">
            <view class="moment-icon">✨</view>
            <view class="moment-title">最新动态</view>
          </view>
          <view class="moment-content">{{profile.latestMoment}}</view>
        </view>
      </view>
      <view class="bottom-space {{isSharedView ? 'bottom-space-lg' : ''}}" />
    </scroll-view>

    <!-- Actions -->
    <view class="action-bar {{isSharedView ? 'action-bar-column' : ''}}" wx:if="{{!isEditing}}">
      <button wx:if="{{!isSharedView}}" class="btn-secondary" bindtap="openEdit">编辑名片</button>
      <button wx:if="{{!isSharedView}}" class="btn-primary" open-type="share">分享我的名片</button>
      <!-- 访客视图：先和主人的 AI 分身聊聊，再带着具体理由请求认识 -->
      <button wx:if="{{isSharedView}}" class="btn-primary btn-agent-entry" bindtap="goVisitorChat">💬 先和我的分身聊聊</button>
      <button wx:if="{{isSharedView}}" class="btn-secondary" bindtap="goHome">✨ 创建我自己的 VibeCard</button>
    </view>
  </view>

  <!-- Share Canvas -->
  <canvas type="2d" id="shareCanvas" style="width: 750px; height: 600px; position: fixed; top: -9999px; left: -9999px;"></canvas>

  <!-- Edit Modal -->
  <wxs module="utils">
    module.exports = {
      includes: function(arr, item) {
        if (!arr) return false;
        return arr.indexOf(item) !== -1;
      }
    }
  </wxs>

  <view wx:if="{{isEditing}}" class="modal-overlay" bindtap="closeEdit">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title">编辑名片</view>
        <view class="modal-actions">
          <view class="modal-close" bindtap="closeEdit">取消</view>
          <view class="modal-save-btn" bindtap="saveEdit">完成</view>
        </view>
      </view>
      <scroll-view scroll-y class="modal-body" enhanced show-scrollbar="{{false}}" scroll-into-view="">
        <!-- Avatar -->
        <view class="edit-section">
          <view class="section-title-new">头像</view>
          <view class="avatar-edit-row">
            <view class="avatar-preview-wrap" bindtap="chooseAvatar">
              <image wx:if="{{editAvatar}}" class="avatar-preview-img" src="{{editAvatar}}" mode="aspectFill" />
              <view wx:else class="avatar-preview-placeholder">{{editName ? editName[0] : '?'}}</view>
            </view>
            <view class="avatar-edit-actions">
              <view class="avatar-mode-pill {{avatarMode === 'generated' ? 'avatar-mode-active' : ''}}" bindtap="setAvatarMode" data-mode="generated">随机生成</view>
              <view class="avatar-mode-pill {{avatarMode === 'custom' ? 'avatar-mode-active' : ''}}" bindtap="setAvatarMode" data-mode="custom">本地上传</view>
            </view>
          </view>
          <scroll-view wx:if="{{avatarMode === 'generated'}}" scroll-x class="h-scroll" enhanced show-scrollbar="{{false}}">
            <view class="h-scroll-inner">
              <view wx:for="{{avatarSeeds}}" wx:key="*this" class="avatar-seed {{editAvatarSeed === item ? 'avatar-seed-active' : ''}}" bindtap="selectAvatarSeed" data-seed="{{item}}">{{item}}</view>
            </view>
          </scroll-view>
          <view wx:if="{{avatarMode === 'custom'}}" class="field-tip">点击头像从相册或相机选择</view>
        </view>

        <!-- Basic Info -->
        <view class="edit-section">
          <view class="input-group">
            <view class="input-label">名字 <text class="input-required">*</text></view>
            <input class="edit-input font-bold" placeholder="你的名字" placeholder-style="color: #a3a3a3;" value="{{editName}}" bindinput="onEditNameInput" />
          </view>
          <view class="input-group">
            <view class="input-label">vibecard ID</view>
            <input class="edit-input edit-input-handle" placeholder="vibecard ID" placeholder-style="color: #a3a3a3;" value="{{editHandle}}" bindinput="onEditHandleInput" />
          </view>
          <view class="input-group">
            <view class="input-label">个人简介</view>
            <textarea class="edit-textarea" placeholder="写一句炫酷的个人简介..." placeholder-style="color: #a3a3a3;" value="{{editBio}}" bindinput="onEditBioInput" />
            <view class="field-tip">简介会展示在名片正文中</view>
          </view>
        </view>

        <!-- Tags -->
        <view class="edit-section">
          <view class="section-header">
            <text class="section-title-new">我的标签</text>
            <text class="section-subtitle-new">{{editTags.length}}/5</text>
          </view>
          <scroll-view scroll-x class="h-scroll" enhanced show-scrollbar="{{false}}">
            <view class="h-scroll-inner">
              <view wx:for="{{tagOptions}}" wx:key="*this" class="pill {{utils.includes(editTags, item) ? 'pill-active' : ''}}" bindtap="onEditTagSelect" data-tag="{{item}}">{{item}}</view>
            </view>
          </scroll-view>
          <view class="custom-tag-row">
            <input class="custom-tag-input" placeholder="输入自定义标签..." placeholder-style="color: #a3a3a3;" value="{{editCustomTag}}" bindinput="onEditCustomTagInput" />
            <view class="custom-tag-btn {{editCustomTag ? 'custom-tag-btn-active' : ''}}" bindtap="addEditCustomTag">添加</view>
          </view>
        </view>

        <!-- Looking For -->
        <view class="edit-section">
          <view class="section-title-new">寻找什么</view>
          <scroll-view scroll-x class="h-scroll" enhanced show-scrollbar="{{false}}">
            <view class="h-scroll-inner">
              <view wx:for="{{lookingForOptions}}" wx:key="*this" class="pill-card {{editLookingFor === item ? 'pill-card-active' : ''}}" bindtap="onEditLookingSelect" data-item="{{item}}">{{item}}</view>
            </view>
          </scroll-view>
        </view>

        <!-- Event -->
        <view class="edit-section">
          <view class="section-title-new">当前活动</view>
          <scroll-view scroll-x class="h-scroll" enhanced show-scrollbar="{{false}}">
            <view class="h-scroll-inner">
              <view wx:for="{{eventOptions}}" wx:key="*this" class="pill-card {{editEvent === item ? 'pill-card-active' : ''}}" bindtap="onEditEventSelect" data-item="{{item}}">{{item}}</view>
            </view>
          </scroll-view>
        </view>

        <!-- Verified Accounts -->
        <view class="edit-section">
          <view class="section-title-new">已验证账号（选填）</view>
          <view class="field-tip">添加你的社交账号，展示在名片上</view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">💼</view>
            <input class="verified-input" placeholder="钱包地址 0x..." value="{{editWallet}}" bindinput="onEditWalletInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">🐦</view>
            <input class="verified-input" placeholder="Twitter @handle" value="{{editTwitter}}" bindinput="onEditTwitterInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">💬</view>
            <input class="verified-input" placeholder="Discord username" value="{{editDiscord}}" bindinput="onEditDiscordInput" />
          </view>
          <view class="verified-input-row">
            <view class="verified-icon-wrap">💚</view>
            <input class="verified-input" placeholder="微信 ID" value="{{editWechat}}" bindinput="onEditWechatInput" />
          </view>
        </view>

        <!-- Highlights -->
        <view class="edit-section">
          <view class="section-header">
            <text class="section-title-new">高光时刻</text>
            <text class="section-subtitle-new" bindtap="addHighlight">+ 添加</text>
          </view>
          <view wx:for="{{editHighlights}}" wx:key="id" class="highlight-edit-row">
            <input class="highlight-edit-icon" value="{{item.icon}}" placeholder="✨" maxlength="2" bindinput="onHighlightIconInput" data-id="{{item.id}}" />
            <input class="highlight-edit-title" value="{{item.title}}" placeholder="一句话描述..." bindinput="onHighlightTitleInput" data-id="{{item.id}}" />
            <view class="highlight-edit-delete" bindtap="removeHighlight" data-id="{{item.id}}">✕</view>
          </view>
          <view wx:if="{{editHighlights.length === 0}}" class="field-tip">点击"+ 添加"记录你的高光时刻</view>
        </view>

        <view class="bottom-space-sm" />
      </scroll-view>
    </view>
  </view>
</view>
