<view class="page">
  <navbar title="互动卡片" showBack />

  <view class="game-header">
    <view class="game-subtitle">抽一张卡片，开启对话</view>
  </view>

  <view class="game-body">
    <!-- Current Card Display -->
    <view class="card-display-wrapper">
      <view class="card-display {{cardAnimClass}} {{isDrawing ? 'is-shuffling' : ''}} {{!currentCard && !isDrawing ? 'card-empty' : ''}}">

        <!-- 洗牌中状态 -->
        <view wx:if="{{isDrawing}}" class="shuffling-state">
          <view class="shuffling-icon">🃏</view>
          <view class="shuffling-text">洗牌中...</view>
        </view>

        <!-- 卡片内容 -->
        <view wx:elif="{{currentCard}}" class="card-content">
          <view class="card-question">{{currentCard.question}}</view>
          <view class="card-source">
            <text class="source-label">来源</text>
            <text class="source-name">{{currentCard.source}}</text>
          </view>
          <view class="card-tags">
            <view wx:for="{{currentCard.tags}}" wx:key="*this" class="card-tag">{{item}}</view>
          </view>
        </view>

        <!-- 空占位 -->
        <view wx:else class="card-placeholder-content">
          <view class="placeholder-icon">🎴</view>
          <view class="placeholder-text">点击抽卡开始</view>
        </view>
      </view>
    </view>

    <!-- 空状态：所有卡片抽完 -->
    <view wx:if="{{filteredCount === 0 && totalPlayed > 0}}" class="empty-state">
      <view class="empty-icon">🎉</view>
      <view class="empty-title">全部抽完！</view>
      <view class="empty-desc">你已经探索了所有卡片</view>
      <view class="empty-reset-btn" bindtap="resetAll">重新开始</view>
    </view>

    <!-- Stats -->
    <view class="game-stats">
      <view class="stat-item">
        <view class="stat-value">{{totalPlayed}}</view>
        <view class="stat-label">已抽</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{filteredCount}}</view>
        <view class="stat-label">剩余</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{favorites.length}}</view>
        <view class="stat-label">收藏</view>
      </view>
    </view>

    <!-- Actions -->
    <view class="game-actions">
      <button class="draw-btn {{filteredCount === 0 ? 'draw-btn-disabled' : ''}}" bindtap="drawCard">
        {{isDrawing ? '洗牌中...' : (currentCard ? '再抽一张' : '抽卡')}}
      </button>
      <view wx:if="{{currentCard && !isDrawing}}" class="secondary-actions">
        <view class="action-btn {{isCurrentFav ? 'action-fav' : ''}}" bindtap="toggleFavorite">
          <view class="action-btn-icon {{isCurrentFav ? 'heart-beat' : ''}}">
            <text>{{isCurrentFav ? '❤️' : '🤍'}}</text>
          </view>
          <text class="action-btn-text">{{isCurrentFav ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
    </view>

    <!-- Filter Toggle -->
    <view class="filter-toggle" bindtap="toggleFilters">
      <text class="filter-toggle-text">{{showFilters ? '收起筛选' : '筛选卡片'}}</text>
      <text class="filter-toggle-count" wx:if="{{selectedTags.length > 0 || selectedPreset}}">{{filteredCount}}张</text>
      <text class="toggle-icon">{{showFilters ? '▲' : '▼'}}</text>
    </view>

    <!-- Filters -->
    <view wx:if="{{showFilters}}" class="filters-panel">
      <!-- 预设场景 - 卡片式布局 -->
      <view class="filter-section">
        <view class="filter-section-title">预设场景</view>
        <view class="preset-grid">
          <view wx:for="{{presets}}" wx:key="id" class="preset-card {{selectedPreset === item.id ? 'preset-card-active' : ''}}" bindtap="selectPreset" data-preset="{{item.id}}">
            <view class="preset-card-name">{{item.name}}</view>
            <view class="preset-card-count">{{item.tags.length}}个标签</view>
          </view>
        </view>
      </view>

      <!-- 标签分类 -->
      <view wx:for="{{tagCategories}}" wx:key="id" class="filter-section">
        <view class="filter-section-title">{{item.name}}</view>
        <view class="filter-options">
          <view wx:for="{{tags}}" wx:for-item="tag" wx:key="id" wx:if="{{tag.category === item.id}}" class="filter-chip {{selectedTags.includes(tag.id) ? 'filter-chip-active' : ''}}" bindtap="toggleTag" data-tag="{{tag.id}}">{{tag.name}}</view>
        </view>
      </view>

      <!-- 筛选结果 -->
      <view class="filter-result-bar">
        <text class="filter-result-text">符合条件的卡片：{{filteredCount}} 张</text>
        <text class="filter-result-reset" bindtap="resetAll" wx:if="{{history.length > 0}}">重置历史</text>
      </view>
    </view>

    <!-- History Toggle -->
    <view class="filter-toggle" bindtap="toggleHistory">
      <text class="filter-toggle-text">历史记录</text>
      <text class="filter-toggle-count" wx:if="{{history.length > 0}}">{{history.length}}张</text>
      <text class="toggle-icon">{{showHistory ? '▲' : '▼'}}</text>
    </view>

    <view wx:if="{{showHistory}}" class="history-list">
      <view wx:for="{{historyCards}}" wx:key="id" class="history-item {{favorites.includes(item.id) ? 'history-item-fav' : ''}}">
        <view class="history-main">
          <view class="history-question">{{item.question}}</view>
          <view class="history-meta">
            <text class="history-source">{{item.source}}</text>
            <text class="history-fav-tag" wx:if="{{favorites.includes(item.id)}}">❤️ 已收藏</text>
          </view>
        </view>
      </view>
      <view wx:if="{{history.length > 0}}" class="reset-btn" bindtap="resetAll">重置历史</view>
      <view wx:if="{{history.length === 0}}" class="history-empty">暂无历史记录</view>
    </view>
  </view>
</view>
