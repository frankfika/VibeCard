.page {
  height: 100vh;
  background: #ffffff;
  color: #0a0a0a;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, SF Pro Display, PingFang SC, sans-serif;
}
.page-body {
  flex: 1;
  padding: 0 48rpx;
  min-height: 0;
}
.section {
  margin-bottom: 40rpx;
}
.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #a3a3a3;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
}
.label-icon {
  font-size: 28rpx;
}

/* Identity Card */
.identity-card {
  position: relative;
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 32rpx;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.identity-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(135deg, #0a0a0a 0%, #2a2a2a 50%, #0a0a0a 100%);
  opacity: 0.06;
  border-radius: 32rpx 32rpx 0 0;
}
.identity-content {
  position: relative;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.identity-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.identity-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0a0a0a 0%, #333333 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.identity-icon {
  font-size: 40rpx;
}
.identity-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
  color: #0a0a0a;
}
.identity-desc {
  font-size: 24rpx;
  color: #a3a3a3;
}
.identity-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}
.identity-progress-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 4rpx solid #e8e8e8;
}
.progress-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #0a0a0a;
  line-height: 1;
}
.progress-label {
  font-size: 18rpx;
  color: #a3a3a3;
  font-weight: 600;
  margin-top: 4rpx;
}
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  font-size: 22rpx;
  font-weight: 700;
  color: #a3a3a3;
}
.status-complete {
  background: rgba(10,10,10,0.08);
  color: #0a0a0a;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}
.stat-card {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 28rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #0a0a0a;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 500;
}

/* Entry Card */
.entry-card {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s ease;
}
.entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.entry-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #f5f5f5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.entry-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
  color: #0a0a0a;
}
.entry-desc {
  font-size: 24rpx;
  color: #a3a3a3;
}
.entry-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #a3a3a3;
}

/* Grid */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.grid-card {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s ease;
}
.grid-card:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.grid-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
  color: #0a0a0a;
}
.grid-desc {
  font-size: 22rpx;
  color: #a3a3a3;
  line-height: 1.4;
}

/* Settings List */
.settings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.settings-item {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s ease;
}
.settings-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.settings-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.settings-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.settings-text {
  display: flex;
  flex-direction: column;
}
.settings-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
  color: #0a0a0a;
}
.settings-desc {
  font-size: 24rpx;
  color: #a3a3a3;
}
.settings-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #a3a3a3;
}
.settings-item-danger:active {
  background: rgba(239,68,68,0.02);
}

/* Version Footer */
.version-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  gap: 8rpx;
}
.version-text {
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 500;
}
.version-sub {
  font-size: 22rpx;
  color: #d4d4d4;
}

.bottom-space {
  height: 120rpx;
}

/* About Modal */
.about-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.about-sheet {
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.about-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  background: #ffffff;
}
.about-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0a0a0a;
}
.about-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #a3a3a3;
}
.about-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 48rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}
.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0a0a0a 0%, #333333 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}
.about-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0a0a0a;
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}
.about-version {
  font-size: 26rpx;
  color: #a3a3a3;
  font-weight: 500;
  margin-bottom: 32rpx;
}
.about-desc {
  font-size: 28rpx;
  color: #737373;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 40rpx;
}
.about-features {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.about-feature {
  background: #f5f5f5;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #0a0a0a;
  font-weight: 500;
}
