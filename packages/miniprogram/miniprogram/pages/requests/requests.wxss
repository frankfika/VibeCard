/* 联系请求：与主人端一致的浅色温暖风格 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbf7f2;
  box-sizing: border-box;
  /* 给自定义 tabBar 让出底部空间 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------- 列表 ---------- */

.list-wrap {
  padding: 24rpx 32rpx;
}

.list-hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: #b8ab9e;
  margin-bottom: 32rpx;
}

.request-card {
  display: flex;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(138, 109, 79, 0.08);
}

.request-card:active {
  opacity: 0.9;
}

.request-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2ebe2;
}

.request-main {
  flex: 1;
  min-width: 0;
}

.request-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.request-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d332a;
}

.request-time {
  font-size: 22rpx;
  color: #b8ab9e;
}

.request-reason {
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b5d4f;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.request-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #8a7a68;
  background: rgba(138, 122, 104, 0.1);
  border-radius: 100rpx;
  padding: 6rpx 16rpx;
}

.request-badge-pending {
  color: #b0663f;
  background: rgba(176, 102, 63, 0.1);
}

.request-badge-connected {
  color: #608a3e;
  background: rgba(96, 138, 62, 0.12);
}

.demo-reset {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b8ab9e;
  padding: 16rpx;
}

/* 空收件箱 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 160rpx 32rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d332a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a7a68;
  max-width: 480rpx;
}

/* 无头像时的占位（云端请求不带头像） */
.request-avatar-placeholder,
.detail-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #b0663f;
  background: rgba(176, 102, 63, 0.12);
}

.vibe-take-loading {
  font-size: 26rpx;
  color: #a08a72;
  padding: 12rpx 0;
}

.share-empty {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a7a68;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* ---------- 详情 ---------- */

.detail-scroll {
  flex: 1;
  min-height: 0;
}

.detail-inner {
  padding: 24rpx 32rpx 0;
}

.detail-spacer {
  height: 48rpx;
}

.detail-back {
  font-size: 26rpx;
  color: #b0663f;
  padding: 8rpx 0 24rpx;
}

.detail-section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(138, 109, 79, 0.06);
}

.detail-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #8a6d4f;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.detail-visitor {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2ebe2;
}

.detail-summary {
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d332a;
}

.detail-reason {
  font-size: 28rpx;
  line-height: 1.7;
  color: #3d332a;
}

.shared-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.shared-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b0663f;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.shared-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b5d4f;
}

.vibe-take {
  background: #fff3e4;
  border: 1rpx solid rgba(176, 102, 63, 0.2);
}

.vibe-take-summary {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d332a;
  margin-bottom: 16rpx;
}

.vibe-take-item {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b5d4f;
  margin-bottom: 10rpx;
}

.vibe-take-uncertain {
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08a72;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(176, 102, 63, 0.3);
}

/* ---------- 操作按钮 ---------- */

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #fbf7f2;
  border-top: 1rpx solid rgba(138, 109, 79, 0.12);
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border-radius: 100rpx;
  background: #ffffff;
  color: #b0663f;
  border: 1rpx solid rgba(176, 102, 63, 0.3);
}

.action-btn:active {
  opacity: 0.8;
}

.action-btn-primary {
  background: #b0663f;
  color: #fff8f2;
  border-color: #b0663f;
}

.action-btn-quiet {
  color: #8a7a68;
  border-color: rgba(138, 122, 104, 0.3);
}

.action-btn-disabled {
  opacity: 0.45;
}

/* ---------- 选择联系方式 ---------- */

.share-wrap {
  padding: 32rpx;
}

.share-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d332a;
  margin-bottom: 12rpx;
}

.share-hint {
  font-size: 24rpx;
  color: #b8ab9e;
  margin-bottom: 32rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(138, 109, 79, 0.15);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.contact-item-checked {
  border-color: #b0663f;
  background: #fff8f2;
}

.contact-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(138, 109, 79, 0.3);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #b0663f;
}

.contact-item-checked .contact-check {
  border-color: #b0663f;
  background: rgba(176, 102, 63, 0.1);
}

.contact-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d332a;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 24rpx;
  color: #b8ab9e;
}

.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

/* ---------- 结果态 ---------- */

.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 160rpx 64rpx 0;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d332a;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a7a68;
  max-width: 480rpx;
}

.result-shared {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}

.result-shared-label {
  font-size: 22rpx;
  color: #b8ab9e;
  margin-bottom: 12rpx;
}

.result-shared-item {
  font-size: 26rpx;
  color: #3d332a;
  line-height: 1.8;
}

.result-btn {
  margin-top: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #b0663f;
  padding: 20rpx 48rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(176, 102, 63, 0.3);
  background: #ffffff;
}
