.page {
  min-height: 100vh;
  background: #ffffff;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 240rpx 64rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0a0a0a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #737373;
  max-width: 480rpx;
}
