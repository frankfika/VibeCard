/* 联系请求：与主人端一致的浅色温暖风格 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f8;
  box-sizing: border-box;
  /* 给自定义 tabBar 让出底部空间 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------- 列表 ---------- */

.list-wrap {
  padding: 24rpx 32rpx;
}

.list-hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: #b6b6bd;
  margin-bottom: 32rpx;
}

.request-card {
  display: flex;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(17, 17, 19, 0.08);
}

.request-card:active {
  opacity: 0.9;
}

.request-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eceefe;
}

.request-main {
  flex: 1;
  min-width: 0;
}

.request-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.request-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #16161a;
}

.request-time {
  font-size: 22rpx;
  color: #b6b6bd;
}

.request-reason {
  font-size: 26rpx;
  line-height: 1.5;
  color: #3f3f46;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.request-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #8e8e93;
  background: rgba(17, 17, 19, 0.1);
  border-radius: 100rpx;
  padding: 6rpx 16rpx;
}

.request-badge-pending {
  color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
}

.request-badge-connected {
  color: #608a3e;
  background: rgba(96, 138, 62, 0.12);
}

.demo-reset {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b6b6bd;
  padding: 16rpx;
}

/* 空收件箱 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 160rpx 32rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #8e8e93;
  max-width: 480rpx;
}

/* 无头像时的占位（云端请求不带头像） */
.request-avatar-placeholder,
.detail-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.12);
}

.vibe-take-loading {
  font-size: 26rpx;
  color: #8e8e93;
  padding: 12rpx 0;
}

.share-empty {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8e8e93;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 拉黑入口：视觉弱于主操作的小字灰色文字按钮 */
.block-entry {
  text-align: center;
  font-size: 24rpx;
  color: #b6b6bd;
  padding: 24rpx 0 8rpx;
}

.block-entry:active {
  color: #8e8e93;
}

/* ---------- 详情 ---------- */

.detail-scroll {
  flex: 1;
  min-height: 0;
}

.detail-inner {
  padding: 24rpx 32rpx 0;
}

.detail-spacer {
  height: 220rpx;
}

.detail-back {
  font-size: 26rpx;
  color: #6366f1;
  padding: 8rpx 0 24rpx;
}

.detail-section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(17, 17, 19, 0.06);
}

.detail-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6366f1;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.detail-visitor {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eceefe;
}

.detail-summary {
  font-size: 28rpx;
  line-height: 1.6;
  color: #16161a;
}

.detail-reason {
  font-size: 28rpx;
  line-height: 1.7;
  color: #16161a;
}

.shared-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.shared-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6366f1;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.shared-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #3f3f46;
}

.vibe-take {
  background: #eceefe;
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}

.vibe-take-summary {
  font-size: 30rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 16rpx;
}

.vibe-take-item {
  font-size: 26rpx;
  line-height: 1.6;
  color: #3f3f46;
  margin-bottom: 10rpx;
}

.vibe-take-uncertain {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8e8e93;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(99, 102, 241, 0.3);
}

/* ---------- 操作按钮 ---------- */

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #f7f7f8;
  border-top: 1rpx solid rgba(17, 17, 19, 0.12);
}

.action-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border-radius: 100rpx;
  background: #ffffff;
  color: #6366f1;
  border: 1rpx solid rgba(99, 102, 241, 0.3);
}

.action-btn:active {
  opacity: 0.8;
}

.action-btn-primary {
  background: #6366f1;
  color: #ffffff;
  border-color: #6366f1;
}

.action-btn-quiet {
  color: #8e8e93;
  border-color: rgba(17, 17, 19, 0.3);
}

.action-btn-disabled {
  opacity: 0.45;
}

/* ---------- 选择联系方式 ---------- */

.share-wrap {
  padding: 32rpx;
}

.share-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 12rpx;
}

.share-hint {
  font-size: 24rpx;
  color: #b6b6bd;
  margin-bottom: 32rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 19, 0.15);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.contact-item-checked {
  border-color: #6366f1;
  background: #ffffff;
}

.contact-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(99, 102, 241, 0.4);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #6366f1;
}

.contact-item-checked .contact-check {
  border-color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
}

.contact-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #16161a;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 24rpx;
  color: #b6b6bd;
}

.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

/* ---------- 结果态 ---------- */

.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 160rpx 64rpx 0;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8e8e93;
  max-width: 480rpx;
}

.result-shared {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}

.result-shared-label {
  font-size: 22rpx;
  color: #b6b6bd;
  margin-bottom: 12rpx;
}

.result-shared-item {
  font-size: 26rpx;
  color: #16161a;
  line-height: 1.8;
}

.result-btn {
  margin-top: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6366f1;
  padding: 20rpx 48rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  background: #ffffff;
}
.learning-wrap { position: fixed; left: 28rpx; right: 28rpx; bottom: calc(170rpx + env(safe-area-inset-bottom)); z-index: 30; }
.learning-card { padding: 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 18rpx 60rpx rgba(20, 20, 35, 0.18); border: 2rpx solid rgba(99, 102, 241, 0.18); }
.learning-loading { color: #6b6b75; font-size: 25rpx; text-align: center; }
.learning-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.learning-title { color: #202027; font-size: 29rpx; font-weight: 750; }
.learning-visibility { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 999rpx; background: #f0efff; color: #5751bd; font-size: 21rpx; }
.learning-note { margin-top: 12rpx; color: #85858e; font-size: 22rpx; line-height: 1.5; }
.learning-content { margin-top: 22rpx; color: #2f2f38; font-size: 27rpx; line-height: 1.55; }
.learning-edit { width: 100%; box-sizing: border-box; min-height: 112rpx; margin-top: 20rpx; padding: 18rpx 20rpx; border: 2rpx solid #dedde9; border-radius: 18rpx; background: #fafafa; color: #292932; font-size: 26rpx; }
.learning-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.learning-action { flex: 1; padding: 17rpx 8rpx; border-radius: 999rpx; background: #f0f0f3; color: #50505a; text-align: center; font-size: 24rpx; }
.learning-action-primary { background: #6366f1; color: #fff; }
.learning-action-quiet { background: transparent; color: #8b8b94; }
.learning-error { margin-top: 14rpx; color: #a63b31; font-size: 23rpx; line-height: 1.45; }
.learning-done { margin-top: 20rpx; color: #555762; font-size: 24rpx; line-height: 1.5; }
.learning-close { margin-top: 16rpx; color: #6366f1; font-size: 24rpx; font-weight: 700; text-align: right; }
