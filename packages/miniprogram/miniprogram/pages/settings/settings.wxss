/* 数据与隐私页（任务 4.6）—— 复用 card.wxss 的极简原生样式，不引入新设计语言 */
.page {
  height: 100vh;
  background: #f7f7f8;
  color: #16161a;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, SF Pro Display, PingFang SC, sans-serif;
}

.content {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* ----- intro ----- */
.intro-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
}
.intro-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 12rpx;
}
.intro-line {
  font-size: 24rpx;
  color: #4b4b55;
  line-height: 1.6;
}

/* ----- card ----- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.card-danger {
  border: 2rpx solid #fde2e2;
  background: #fffafa;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 12rpx;
}
.card-title-danger {
  color: #b91c1c;
}
.card-desc {
  font-size: 26rpx;
  color: #5b5b65;
  line-height: 1.55;
  margin-bottom: 24rpx;
}

/* ----- buttons ----- */
.btn-primary {
  background: #6366f1;
  color: #ffffff;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  margin: 0;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #c2c2d1;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: #16161a;
  border: 2rpx solid #d8d8de;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 84rpx;
  margin: 0;
}
.btn-secondary::after { border: none; }
.btn-secondary-tight {
  margin-top: 16rpx;
}

.btn-danger {
  background: #dc2626;
  color: #ffffff;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  margin: 0;
}
.btn-danger::after { border: none; }
.btn-danger[disabled] {
  background: #f3a4a4;
  color: #ffffff;
}

/* ----- option checkbox ----- */
.opt-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0 24rpx;
}
.opt-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #c8c8d1;
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.opt-check-on {
  border-color: #6366f1;
}
.opt-check-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #6366f1;
}
.opt-text { flex: 1; }
.opt-text-title {
  font-size: 28rpx;
  color: #16161a;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.opt-text-sub {
  font-size: 24rpx;
  color: #6b6b75;
  line-height: 1.5;
}

/* ----- state chips ----- */
.state {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f4f4f6;
}
.state-success { background: #ecfdf5; color: #166534; }
.state-progress { background: #eef2ff; color: #3730a3; }
.state-error { background: #fef2f2; color: #991b1b; }
.state-info { background: #f4f4f6; color: #2c2c34; }
.state-title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.state-detail {
  font-size: 24rpx;
  line-height: 1.55;
  color: inherit;
  word-break: break-all;
}
.state-retry {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #6366f1;
}

/* ----- delete steps ----- */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.step {
  display: flex;
  align-items: stretch;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f7f9;
}
.step-done {
  background: #ecfdf5;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #c8c8d1;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.step-done .step-num {
  background: #16a34a;
}
.step-body { flex: 1; }
.step-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #16161a;
  margin-bottom: 4rpx;
}
.step-desc {
  font-size: 24rpx;
  color: #5b5b65;
  line-height: 1.55;
}

.delete-input {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #d8d8de;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: #ffffff;
}

/* ----- import confirm sheet ----- */
.confirm-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 15, 19, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}
.confirm-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.confirm-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #16161a;
  margin-bottom: 12rpx;
}
.confirm-desc {
  font-size: 26rpx;
  color: #4b4b55;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.confirm-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.confirm-btn-cancel {
  background: #f4f4f6;
  color: #16161a;
}
.confirm-btn-danger {
  background: #dc2626;
  color: #ffffff;
}

.bottom-space { height: 200rpx; }