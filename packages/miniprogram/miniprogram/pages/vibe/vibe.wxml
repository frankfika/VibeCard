<view class="page">
  <navbar title="我的 Vibe" />

  <view wx:if="{{loadError}}" class="memory-bar">
    <view class="memory-empty">{{loadError}}</view>
    <view class="card-draft-entry" bindtap="onRetryLoad">重新加载</view>
  </view>

  <!-- 已记住：只有主人确认过的记忆才会出现在这里 -->
  <view class="memory-bar">
    <view class="memory-bar-header">
      <view class="memory-bar-title">已记住</view>
      <view class="memory-bar-count">{{memories.length}} 条</view>
    </view>
    <scroll-view scroll-y class="memory-list">
      <view wx:for="{{memories}}" wx:key="id" class="memory-item">
        <view class="memory-tag">{{item.visibilityLabel}}</view>
        <view class="memory-text">{{item.content}}</view>
      </view>
      <view wx:if="{{memories.length === 0}}" class="memory-empty">还没有记住任何事。聊点什么吧。</view>
    </scroll-view>
    <view class="card-draft-entry {{cardDraftLoading ? 'card-draft-entry-loading' : ''}}" bindtap="onGenerateCardDraft">
      {{cardDraftLoading ? 'Vibe 正在起草…' : '让 Vibe 更新我的 Card'}}
    </view>
  </view>

  <!-- 最近动态（任务 4.5）：主人确认发布的一小段公开动态，不是 Feed -->
  <view class="now-bar">
    <view class="memory-bar-header">
      <view class="memory-bar-title">最近动态</view>
      <view class="memory-bar-count">{{nowItems.length}} 条</view>
    </view>
    <scroll-view scroll-y class="now-list">
      <view wx:for="{{nowItems}}" wx:key="id" class="now-item">
        <view class="now-item-head">
          <view class="now-topic">{{item.topicLabel}}</view>
          <view class="now-status now-status-{{item.status}}">{{item.statusLabel}}</view>
        </view>
        <view wx:if="{{nowEditingId !== item.id}}" class="now-text" bindtap="onNowEditStart" data-id="{{item.id}}">{{item.text}}</view>
        <view wx:if="{{nowEditingId === item.id}}" class="now-edit">
          <textarea class="proposal-edit-input" value="{{nowEditText}}" bindinput="onNowEditInput" auto-height maxlength="200" />
          <view class="proposal-actions">
            <view class="proposal-btn proposal-btn-primary" bindtap="onNowEditSave">保存</view>
            <view class="proposal-btn proposal-btn-quiet" bindtap="onNowEditCancel">取消</view>
          </view>
        </view>
        <view class="now-actions">
          <view wx:if="{{item.status === 'draft' || item.status === 'archived' || item.status === 'hidden'}}" class="now-action now-action-primary" bindtap="onPublishNow" data-id="{{item.id}}">发布</view>
          <view wx:if="{{item.status !== 'archived'}}" class="now-action" bindtap="onArchiveNow" data-id="{{item.id}}">归档</view>
          <view wx:if="{{item.status !== 'hidden'}}" class="now-action" bindtap="onHideNow" data-id="{{item.id}}">隐藏</view>
          <view class="now-action now-action-quiet" bindtap="onDeleteNow" data-id="{{item.id}}">删除</view>
        </view>
      </view>
      <view wx:if="{{nowItems.length === 0}}" class="memory-empty">还没有最近动态。写一句，或者聊出什么值得放的，Vibe 会提议。</view>
    </scroll-view>
    <view class="now-composer">
      <view class="now-topic-row">
        <view wx:for="{{nowTopics}}" wx:key="value" class="now-topic-chip {{nowComposerTopic === item.value ? 'now-topic-chip-active' : ''}}" bindtap="onNowComposerTopic" data-topic="{{item.value}}">{{item.label}}</view>
      </view>
      <view class="now-composer-row">
        <input class="now-composer-input" placeholder="写一句最近动态…" placeholder-style="color: #a8a8b0;" value="{{nowComposer}}" bindinput="onNowComposerInput" maxlength="200" />
        <view class="now-composer-btn {{nowComposer ? 'now-composer-btn-active' : ''}}" bindtap="onCreateNowDraft">存草稿</view>
      </view>
    </view>
  </view>

  <!-- 对话区 -->
  <scroll-view scroll-y class="chat" scroll-into-view="{{scrollIntoId}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="chat-inner">
      <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="msg-row {{item.role === 'owner' ? 'msg-row-owner' : ''}}">
        <view class="msg-bubble {{item.role === 'owner' ? 'msg-bubble-owner' : 'msg-bubble-vibe'}}">
          <view class="msg-text">{{item.text}}</view>
          <!-- 记忆回调：这条回复来自你之前告诉我的事 -->
          <view wx:if="{{item.memoryRefs}}" class="memory-refs">
            <view wx:for="{{item.memoryRefs}}" wx:for-item="ref" wx:key="id" class="memory-ref-chip">↩ {{ref.short}}</view>
          </view>
        </view>
      </view>

      <!-- 记忆提议卡片：Vibe 可以提议，但只有主人确认后才算数 -->
      <view wx:if="{{proposal}}" id="proposal-card" class="proposal {{proposal.state === 'confirmed' ? 'proposal-confirmed' : ''}}">
        <view class="proposal-label">我记住了：</view>
        <view wx:if="{{proposal.state !== 'editing'}}" class="proposal-text">{{proposal.text}}</view>

        <view wx:if="{{proposal.state === 'pending'}}" class="proposal-actions">
          <view class="proposal-btn proposal-btn-primary" bindtap="onRememberProposal">记住</view>
          <view class="proposal-btn" bindtap="onEditProposal">改一下</view>
          <view class="proposal-btn proposal-btn-quiet" bindtap="onDismissProposal">别记这个</view>
        </view>

        <view wx:if="{{proposal.state === 'editing'}}" class="proposal-edit">
          <textarea class="proposal-edit-input" value="{{proposal.editText}}" bindinput="onProposalEditInput" auto-height maxlength="200" />
          <view class="proposal-actions">
            <view class="proposal-btn proposal-btn-primary" bindtap="onSaveEditedProposal">确认记住</view>
            <view class="proposal-btn proposal-btn-quiet" bindtap="onCancelEditProposal">取消</view>
          </view>
        </view>

        <view wx:if="{{proposal.state === 'confirmed'}}" class="proposal-done">✓ 已记住，可以在上面「已记住」里看到</view>
      </view>

      <!-- Now 提议卡片（任务 4.5）：Vibe 只能提议草稿，发布由主人决定 -->
      <view wx:if="{{nowProposal}}" id="now-proposal-card" class="proposal {{nowProposal.state === 'published' ? 'proposal-confirmed' : ''}}">
        <view class="proposal-label">要不要放到你的最近动态？</view>
        <view wx:if="{{nowProposal.state !== 'editing'}}" class="proposal-text">{{nowProposal.text}}</view>

        <view wx:if="{{nowProposal.state === 'pending'}}" class="proposal-actions">
          <view class="proposal-btn proposal-btn-primary" bindtap="onPublishNowProposal">发布</view>
          <view class="proposal-btn" bindtap="onEditNowProposal">改一下</view>
          <view class="proposal-btn proposal-btn-quiet" bindtap="onDismissNowProposal">先不发</view>
        </view>

        <view wx:if="{{nowProposal.state === 'editing'}}" class="proposal-edit">
          <textarea class="proposal-edit-input" value="{{nowProposal.editText}}" bindinput="onNowProposalEditInput" auto-height maxlength="200" />
          <view class="proposal-actions">
            <view class="proposal-btn proposal-btn-primary" bindtap="onSaveEditedNowProposal">确认发布</view>
            <view class="proposal-btn proposal-btn-quiet" bindtap="onCancelEditNowProposal">取消</view>
          </view>
        </view>

        <view wx:if="{{nowProposal.state === 'published'}}" class="proposal-done">✓ 已发布，会显示在你的名片「最近动态」里</view>
      </view>

      <!-- Card 草稿预览：Vibe 只建议，主人决定是否采用 -->
      <view wx:if="{{cardDraft}}" id="card-draft-panel" class="card-draft">
        <view class="card-draft-title">Vibe 起草的 Card 更新</view>
        <view class="card-draft-sub">只基于你已确认的记忆；采用前可以先对比。</view>
        <view wx:for="{{cardDraft.rows}}" wx:key="key" class="card-draft-row">
          <view class="card-draft-label">{{item.label}}</view>
          <view class="card-draft-old">{{item.oldText}}</view>
          <view class="card-draft-arrow">↓</view>
          <view class="card-draft-new">{{item.newText}}</view>
        </view>
        <view class="proposal-actions">
          <view class="proposal-btn proposal-btn-primary" bindtap="onAcceptCardDraft">采用</view>
          <view class="proposal-btn proposal-btn-quiet" bindtap="onRejectCardDraft">放弃</view>
        </view>
      </view>

      <view class="chat-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部输入栏（位于 tabBar 之上） -->
  <view class="input-bar">
    <input class="input-field" placeholder="和你的 Vibe 聊聊…" placeholder-style="color: #a8a8b0;" value="{{inputValue}}" bindinput="onInput" bindconfirm="onSend" confirm-type="send" />
    <view class="send-btn {{inputValue ? 'send-btn-active' : ''}}" bindtap="onSend">发送</view>
  </view>
</view>
