/* 我的 Vibe：浅色温暖风格，与访客端深色分身对话区分 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbf7f2;
  box-sizing: border-box;
  /* 给自定义 tabBar 让出底部空间（约 150rpx + 安全区） */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------- 已记住 ---------- */

.memory-bar {
  flex-shrink: 0;
  padding: 24rpx 32rpx 8rpx;
}

.memory-bar-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.memory-bar-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #8a6d4f;
  letter-spacing: 2rpx;
}

.memory-bar-count {
  font-size: 22rpx;
  color: #b8ab9e;
}

.memory-list {
  max-height: 220rpx;
}

.memory-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(138, 109, 79, 0.06);
}

.memory-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #b0663f;
  background: rgba(176, 102, 63, 0.1);
  border-radius: 100rpx;
  padding: 6rpx 16rpx;
  margin-top: 2rpx;
}

.memory-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #3d332a;
}

.memory-empty {
  font-size: 24rpx;
  color: #b8ab9e;
  padding: 16rpx 8rpx;
}

/* ---------- 对话区 ---------- */

.chat {
  flex: 1;
  min-height: 0;
}

.chat-inner {
  padding: 24rpx 32rpx 0;
}

.chat-spacer {
  height: 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-owner {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 76%;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
}

.msg-bubble-vibe {
  background: #ffffff;
  color: #3d332a;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(138, 109, 79, 0.06);
}

.msg-bubble-owner {
  background: #b0663f;
  color: #fff8f2;
  border-top-right-radius: 8rpx;
}

/* ---------- 记忆提议卡片 ---------- */

.proposal {
  background: #fff3e4;
  border: 1rpx solid rgba(176, 102, 63, 0.25);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.proposal-confirmed {
  background: #f2f7ec;
  border-color: rgba(96, 138, 62, 0.25);
}

.proposal-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #b0663f;
  margin-bottom: 12rpx;
}

.proposal-confirmed .proposal-label {
  color: #608a3e;
}

.proposal-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d332a;
  margin-bottom: 24rpx;
}

.proposal-actions {
  display: flex;
  gap: 16rpx;
}

.proposal-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 0;
  border-radius: 100rpx;
  background: #ffffff;
  color: #b0663f;
  border: 1rpx solid rgba(176, 102, 63, 0.3);
}

.proposal-btn:active {
  opacity: 0.8;
}

.proposal-btn-primary {
  background: #b0663f;
  color: #fff8f2;
  border-color: #b0663f;
}

.proposal-btn-quiet {
  color: #8a7a68;
  border-color: rgba(138, 122, 104, 0.3);
}

.proposal-edit-input {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d332a;
  margin-bottom: 24rpx;
  min-height: 96rpx;
}

.proposal-done {
  font-size: 24rpx;
  color: #608a3e;
}

/* ---------- 底部输入栏 ---------- */

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: #fbf7f2;
  border-top: 1rpx solid rgba(138, 109, 79, 0.12);
}

.input-field {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 100rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #3d332a;
  box-shadow: 0 4rpx 20rpx rgba(138, 109, 79, 0.06);
}

.send-btn {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #b8ab9e;
  padding: 16rpx 12rpx;
}

.send-btn-active {
  color: #b0663f;
}
