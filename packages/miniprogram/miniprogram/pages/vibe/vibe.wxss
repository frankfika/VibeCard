/* 我的 Vibe：浅色温暖风格，与访客端深色分身对话区分 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f8;
  box-sizing: border-box;
  /* 给自定义 tabBar 让出底部空间（约 150rpx + 安全区） */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* ---------- 已记住 ---------- */

.memory-bar {
  flex-shrink: 0;
  padding: 24rpx 32rpx 8rpx;
}

.memory-bar-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.memory-bar-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6366f1;
  letter-spacing: 2rpx;
}

.memory-bar-count {
  font-size: 22rpx;
  color: #b6b6bd;
}

.memory-list {
  max-height: 220rpx;
}

.memory-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(17, 17, 19, 0.06);
}

.memory-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
  border-radius: 100rpx;
  padding: 6rpx 16rpx;
  margin-top: 2rpx;
}

.memory-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #16161a;
}

.memory-empty {
  font-size: 24rpx;
  color: #b6b6bd;
  padding: 16rpx 8rpx;
}

/* ---------- 对话区 ---------- */

.chat {
  flex: 1;
  min-height: 0;
}

.chat-inner {
  padding: 24rpx 32rpx 0;
}

.chat-spacer {
  height: 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-owner {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 76%;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
}

.msg-bubble-vibe {
  background: #ffffff;
  color: #16161a;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(17, 17, 19, 0.06);
}

.msg-bubble-owner {
  background: #6366f1;
  color: #ffffff;
  border-top-right-radius: 8rpx;
}

/* 记忆回调 chips：这条回复来自主人之前确认过的记忆，样式温和低调 */
.memory-refs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.memory-ref-chip {
  font-size: 20rpx;
  line-height: 1.5;
  color: #8e8e93;
  background: rgba(99, 102, 241, 0.08);
  border-radius: 100rpx;
  padding: 6rpx 18rpx;
  max-width: 100%;
}

/* ---------- 记忆提议卡片 ---------- */

.proposal {
  background: #eceefe;
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.proposal-confirmed {
  background: #f2f7ec;
  border-color: rgba(96, 138, 62, 0.25);
}

.proposal-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6366f1;
  margin-bottom: 12rpx;
}

.proposal-confirmed .proposal-label {
  color: #608a3e;
}

.proposal-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #16161a;
  margin-bottom: 24rpx;
}

.proposal-actions {
  display: flex;
  gap: 16rpx;
}

.proposal-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 0;
  border-radius: 100rpx;
  background: #ffffff;
  color: #6366f1;
  border: 1rpx solid rgba(99, 102, 241, 0.3);
}

.proposal-btn:active {
  opacity: 0.8;
}

.proposal-btn-primary {
  background: #6366f1;
  color: #ffffff;
  border-color: #6366f1;
}

.proposal-btn-quiet {
  color: #8e8e93;
  border-color: rgba(17, 17, 19, 0.3);
}

.proposal-edit-input {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #16161a;
  margin-bottom: 24rpx;
  min-height: 96rpx;
}

.proposal-done {
  font-size: 24rpx;
  color: #608a3e;
}

/* ---------- 底部输入栏 ---------- */

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: #f7f7f8;
  border-top: 1rpx solid rgba(17, 17, 19, 0.12);
}

.input-field {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  border-radius: 100rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #16161a;
  box-shadow: 0 4rpx 20rpx rgba(17, 17, 19, 0.06);
}

.send-btn {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #b6b6bd;
  padding: 16rpx 12rpx;
}

.send-btn-active {
  color: #6366f1;
}

/* Card 草稿（任务 1.4） */
.card-draft-entry {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.08);
  border-radius: 20rpx;
  padding: 16rpx;
}

.card-draft-entry-loading {
  opacity: 0.6;
}

.card-draft {
  margin: 16rpx 0;
  background: #ffffff;
  border: 1rpx solid rgba(99, 102, 241, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
}

.card-draft-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d2f1d;
}

.card-draft-sub {
  font-size: 22rpx;
  color: #8e8e93;
  margin: 8rpx 0 20rpx;
}

.card-draft-row {
  margin-bottom: 16rpx;
}

.card-draft-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6366f1;
  margin-bottom: 6rpx;
}

.card-draft-old {
  font-size: 24rpx;
  color: #8e8e93;
  text-decoration: line-through;
}

.card-draft-arrow {
  font-size: 20rpx;
  color: #b6b6bd;
  line-height: 1.4;
}

.card-draft-new {
  font-size: 26rpx;
  color: #3d2f1d;
  font-weight: 600;
}
