/* Thread Publish Page - Premium Modern UI */
.page {
  height: 100vh;
  background: #ffffff;
  color: #0a0a0a;
  display: flex;
  flex-direction: column;
}

/* Action Bar */
.publish-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.publish-action-cancel {
  font-size: 30rpx;
  font-weight: 600;
  color: #a3a3a3;
  padding: 16rpx;
  transition: color 0.2s;
}
.publish-action-cancel:active {
  color: #737373;
}

.publish-action-submit {
  font-size: 30rpx;
  font-weight: 700;
  color: #a3a3a3;
  padding: 16rpx 32rpx;
  border-radius: 100rpx;
  background: #f5f5f5;
  transition: all 0.2s;
  min-width: 120rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-action-submit-active {
  background: #0a0a0a;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.publish-action-submit-loading {
  opacity: 0.7;
}

/* Loading Dots */
.submit-loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 8rpx;
}
.loading-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  animation: loadingBounce 1.4s ease-in-out infinite both;
}
.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes loadingBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* Body */
.publish-body {
  flex: 1;
  padding: 32rpx 40rpx;
  overflow-y: auto;
}

/* Content Area */
.content-area {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.author-avatar-placeholder {
  background: #d4d4d4;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* Textarea Wrapper */
.textarea-wrapper {
  flex: 1;
  position: relative;
}

.content-input {
  width: 100%;
  font-size: 32rpx;
  line-height: 1.6;
  color: #0a0a0a;
  min-height: 200rpx;
  max-height: 500rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.content-input-empty {
  animation: shake 0.4s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-4rpx); }
  80% { transform: translateX(4rpx); }
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 500;
  margin-top: 8rpx;
}

/* Empty Tip */
.empty-tip {
  margin-left: 104rpx;
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease-out;
}
.empty-tip-text {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 600;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Image Preview Section */
.image-preview-section {
  margin-bottom: 32rpx;
  margin-left: 104rpx;
}

.image-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-preview-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-img {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: background 0.2s;
}
.remove-img:active {
  background: rgba(0, 0, 0, 0.7);
}

/* Add Image Slot */
.image-preview-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e8e8e8;
  background: #fafafa;
  transition: all 0.2s;
}
.image-preview-add:active {
  background: #f5f5f5;
  border-color: #d4d4d4;
}
.add-icon {
  font-size: 48rpx;
  color: #a3a3a3;
  font-weight: 300;
}

.image-count-hint {
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 600;
  margin-top: 16rpx;
  text-align: right;
}

/* Tag Selector */
.tag-selector {
  margin-bottom: 32rpx;
  margin-left: 104rpx;
}

.selector-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #a3a3a3;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
}

.selector-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.selector-tag {
  padding: 14rpx 32rpx;
  border-radius: 100rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  font-weight: 600;
  color: #737373;
  transition: all 0.2s;
}
.selector-tag:active {
  background: #e8e8e8;
}

.selector-tag-active {
  background: #0a0a0a;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

/* Add Image Button */
.add-image-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  margin-left: 104rpx;
  transition: all 0.2s;
}
.add-image-btn:active {
  background: #e8e8e8;
}

.add-image-icon {
  font-size: 40rpx;
}

.add-image-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #737373;
}

.add-image-hint {
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 500;
}
