# Pinata IPFS JWT（链上同步时必需，用于上传内容到 IPFS）
# 注册 https://pinata.cloud/ → API Keys → New Key → 复制 JWT
VITE_PINATA_JWT=your_pinata_jwt_here

# WalletConnect Project ID（测试网/主网钱包连接、邮箱/社交登录必需）
# 本地 Hardhat 网络使用 MetaMask 等注入钱包时，可不填
# 注册 https://cloud.walletconnect.com/ → New Project → 复制 Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# 可选：RPC 配置（默认已配置公共 RPC）
# VITE_ALCHEMY_KEY=your_alchemy_key

# 可选：Google Gemini API Key（onboarding "生成头像" 按钮启用真实 AI 生成）
# 留空时降级为随机 dicebear 头像
# 注册 https://aistudio.google.com/apikey → Create API Key
# 警告: VITE_ 前缀的变量会被打包到浏览器, 请使用受速率限制的 demo key
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
