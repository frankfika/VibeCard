# scripts/conformance.env.example — copy to scripts/conformance.env then fill in
# All fields are OPTIONAL. Missing AI_*  → falls back to a local mock-parity run
# so the conformance suite still passes against the same code paths.
#
# WARNING: do NOT commit scripts/conformance.env. It is .gitignore-able; the
# runner deliberately never logs the AI_API_KEY value.

# ───── AI provider (OpenAI-compatible) ─────────────────────────────
# Examples:
#   AI_API_BASE=https://api.openai.com              AI_MODEL=gpt-4o-mini
#   AI_API_BASE=https://ark.cn-beijing.volces.com   AI_MODEL=deepseek-v3
#   AI_API_BASE=http://localhost:11434/v1           AI_MODEL=qwen2.5:7b   (Ollama, keyless)
#   AI_API_BASE=http://127.0.0.1:8000/v1            AI_MODEL=Qwen/Qwen2.5-7B-Instruct   (vLLM)
AI_API_BASE=https://api.example.com
AI_API_KEY=sk-replace-with-real-key
AI_MODEL=replace-with-model-id
# Optional: extra static headers as JSON (only from trusted runtime config)
# AI_API_HEADERS={"X-Title":"vibecard"}
# Optional: request timeout in ms (default 15000)
# AI_TIMEOUT_MS=20000

# ───── Force mock regardless of key ────────────────────────────────
# Set AI_PROVIDER=mock to pin the conformance suite to the deterministic mock
# even when AI_API_KEY is present. Use this when you want to prove the harness
# still validates the contract independent of model quality.
# AI_PROVIDER=mock

# ───── WeChat Cloud (optional) ─────────────────────────────────────
# Only needed if you want `node run-real-conformance.mjs` to ALSO invoke
# packages/miniprogram/deploy/deploy-cloud.js. The harness itself does not
# need these — it stubs wx-server-sdk in-process.
# CLOUD_ENV_ID=your-cloud-env-id-from-mp
# MP_PRIVATE_KEY=/absolute/path/to/private.key

# ───── Owner openid (optional, for T1.3 confirmation flow) ─────────
# Used only as a synthetic OPENID in the in-memory harness. The real
# DevTools flow ultimately uses wx.login() + cloud.getWXContext().
# WX_OPENID_OWNER=owner-openid-for-harness
# WX_OPENID_VISITOR=visitor-openid-for-harness
