# VibeCard self-hosted server configuration (task 5.7).
# Copy to deploy/.env and edit. NO real secrets are stored in this template.
# No VibeCard Cloud account or key is required — ever.

# ---------------------------------------------------------------------------
# REQUIRED: single-owner bearer token. Every /api/v1/owner/* endpoint needs
#   Authorization: Bearer <this token>
# Generate one with:  openssl rand -base64 32
# Compose refuses to start while this is unset. Replace the placeholder before
# bringing the stack up; do not reuse a development or test token.
# ---------------------------------------------------------------------------
VIBECARD_OWNER_TOKEN=change-me-generate-a-long-random-token

# Bind host/port inside the container. Keep 0.0.0.0 in Docker; compose maps
# it to 127.0.0.1 on the host by default. For bare-metal runs the default is
# 127.0.0.1 — only bind 0.0.0.0 behind a reverse proxy with TLS.
HOST=0.0.0.0
PORT=8787

# H5/PWA host port. The container stays on 8080 and proxies /api/v1 to the
# private vibecard-server service, so browser owner tokens remain same-origin.
WEB_PORT=8080

# SQLite database file (inside the container this lives on the volume).
VIBECARD_DB_PATH=/data/vibecard.db

# Direct Core API access is private in the Compose stack; pin this to the H5
# origin if you expose Core separately. Wildcard CORS is intentionally avoided.
CORS_ORIGIN=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Model provider (docs/engineering/MODEL_ADAPTERS.md).
# Default: the deterministic mock — zero keys, zero network, full behavior.
# For a real model use any OpenAI-compatible chat-completions endpoint:
#   managed / BYOK:  AI_API_BASE=https://api.example.com  (+ AI_API_KEY)
#   local (Ollama):  AI_API_BASE=http://host.docker.internal:11434/v1
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
# AI_PROVIDER=openai-compatible
# AI_API_BASE=http://host.docker.internal:11434/v1
# AI_MODEL=qwen2.5
# AI_API_KEY=
# AI_API_HEADERS={"x-router-tag":"vibecard"}
# AI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Public stranger-content moderation. The localhost-only quickstart keeps this
# disabled so the copied template is runnable without a placeholder service.
# The endpoint receives POST {"text":"..."} and must return either
# {"ok":true} or {"ok":false,"reason":"..."}. Any outage or malformed
# response fails closed before stranger text reaches storage or the model.
# For a loopback-only evaluation you may set REQUIRE_MODERATION=0; never use
# that override for a public deployment.
# ---------------------------------------------------------------------------
REQUIRE_MODERATION=0
# Before exposing either port beyond loopback, set REQUIRE_MODERATION=1 and a
# real reachable service URL; outages then fail closed.
# MODERATION_API_URL=https://your-moderation-service.example/v1/check
# MODERATION_API_KEY=
MODERATION_TIMEOUT_MS=5000

# Local and remote product sharing does not need Web-hosted snapshots: local
# shares embed a public projection and remote shares point to canonical Core.
# This operator-only compatibility endpoint is disabled by default. If enabled,
# moderation is mandatory and every snapshot expires (maximum accepted: 30d).
ENABLE_PUBLIC_SNAPSHOTS=0
PUBLIC_SNAPSHOT_TTL_MS=604800000

# Visitor rate limits (token bucket per visitor id + IP, per hour).
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_HOUR=10

# Max JSON body size accepted by any endpoint (bytes).
MAX_BODY_BYTES=2097152
